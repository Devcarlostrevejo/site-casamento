# E-mails autorizados a acessar /admin, separados por vírgula.
ADMIN_EMAILS=noiva@example.com,noivo@example.com

# Use true apenas no desenvolvimento local com a identidade de teste do Sites.
ALLOW_TEST_ADMIN=false

# Mantenha sandbox até concluir os testes e trocar conscientemente para production.
ASAAS_ENV=sandbox
ASAAS_API_URL=https://api-sandbox.asaas.com/v3

# Segredos: configure no ambiente de hospedagem; nunca envie ao navegador ou ao Git.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
